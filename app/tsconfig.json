{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@engine/*": ["src/engine/*"],
      "@ui/*": ["src/ui/*"],
      "@sims/*": ["src/sims/*"],
      "@labs/*": ["src/labs/*"]
    }
  },
  "include": ["src", "vite.config.ts"],
  // Files prefixed with an underscore are an agent's working scratch during a
  // build and are never shipped; excluding them keeps a half-written draft
  // from breaking the typecheck for everyone else.
  "exclude": ["src/**/_*.ts", "src/**/_*.tsx"]
}
